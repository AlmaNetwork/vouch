# vouch-node configuration. Copy to /etc/vouch/node.env (root:vouch, chmod 0640).
#
# These are the ONLY variables the node reads — see vouch-node/src/config.ts.
# Anything else you may have seen in older deploy notes is ignored.

# Bind address. The node defaults to LOOPBACK, which serves nothing on a server.
# Behind a reverse proxy on the same host, keep 127.0.0.1 and let the proxy reach it.
# Use 0.0.0.0 only inside a container whose published port is itself loopback-bound.
VOUCH_HOST=127.0.0.1
VOUCH_PORT=8787

# The world's RNG seed. PERMANENT: it is fed to rehydrateAlmaWorld on every boot
# alongside the replayed journal, so changing it later changes replay-derived
# behaviour against an existing journal. Pin it at first deploy and never touch it.
VOUCH_SEED=vouch-node

# Persistence. Unset means IN-MEMORY — the world is lost on restart. These two files
# ARE the state: the journal is replayed from genesis on boot and the accounts log
# holds each principal's nonce. Back them up together; restoring a journal against a
# stale accounts log rewinds nonces and reopens the replay window.
VOUCH_JOURNAL=/var/lib/vouch/journal.jsonl
VOUCH_ACCOUNTS=/var/lib/vouch/accounts.jsonl

# WHICH CODE is running — a git tag or short SHA, reported at GET /health and stamped
# on every log line. Set it at every deploy, from the tag you checked out:
#
#   sudo sed -i "s/^VOUCH_BUILD=.*/VOUCH_BUILD=$(git -C /opt/vouch describe --tags --always)/" /etc/vouch/node.env
#
# Left at the default, /health reports "dev" and a successful deploy is
# indistinguishable from a rollback that silently failed to take.
VOUCH_BUILD=dev

# Structured logging. pino levels: fatal|error|warn|info|debug|trace|silent.
# One JSON object per line on stdout — journald/docker own rotation and shipping.
# Client IPs and request bodies are deliberately never logged; correlation is by the
# requestId the client already receives in the x-request-id header.
VOUCH_LOG_LEVEL=info

# Notary key source. REQUIRED — the node refuses to boot without it, deliberately:
# there is no fallback, so it can never come up on a predictable key. Accepts
# `seed://<literal>` or `env://<VAR>`; `file://` is NOT supported.
#
# The keypair is derived as keyPairFromSeed(sha256(secret)), so the secret string IS
# the private key material. Never commit it, never pass it on a command line, never
# put it in cloud user-data. Generate with:  openssl rand -base64 48
VOUCH_NOTARY=env://VOUCH_NOTARY_SECRET
VOUCH_NOTARY_SECRET=

# Which header carries the real client IP. SET THIS if there is a proxy in front, or
# the per-IP limits below are worthless: behind a loopback reverse proxy every request
# arrives from 127.0.0.1, so the whole world shares one bucket.
#
# It is a SECURITY setting. A header is caller-supplied, so trusting one is only safe
# when this node cannot be reached except through a proxy that OVERWRITES it — with the
# shipped Caddyfile that holds, because authenticated origin pulls mean only Cloudflare
# can reach Caddy, and Cloudflare rewrites CF-Connecting-IP. Expose the node directly
# and anyone sets it per request, gets a fresh bucket each time, and the limit is gone.
VOUCH_CLIENT_IP_HEADER=CF-Connecting-IP

# Rate limits. 0 disables a limit. These start deliberately tight — nothing appended to
# the journal can be taken back, so being too strict costs an annoyed participant while
# being too loose costs a permanent record nobody wanted. Loosen from here.
VOUCH_WRITES_PER_MIN_PER_PRINCIPAL=10
VOUCH_WRITES_PER_HOUR_PER_IP=60
VOUCH_READS_PER_MIN_PER_IP=600
